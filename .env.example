# Puerto local. En Render no se define: Render asigna PORT automáticamente.
PORT=3000

# Orígenes que pueden llamar a la API (separados por coma). Sin espacios raros.
CORS_ORIGINS=http://localhost:5173,https://pi1-salon-estudio.vercel.app

# Ruta al JSON de la cuenta de servicio de Firebase. Debe estar FUERA del repositorio.
# En Render apunta al Secret File: /etc/secrets/firebase-admin.json
GOOGLE_APPLICATION_CREDENTIALS=C:\secrets\pi1-salon-estudio\firebase-admin.json
